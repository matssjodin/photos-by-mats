PORT=4000
DATA_DIR=./data
# Public URL the browser uses; the CSRF guard accepts requests from this origin.
APP_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploy
MAX_UPLOAD_FILES=500
MAX_UPLOAD_FILE_SIZE_MB=120
# Parallel sharp workers during upload ingest (CPU-bound). Default: 3.
INGEST_CONCURRENCY=3
# Days before trashed photos are permanently deleted. 0 disables auto-purge.
TRASH_RETENTION_DAYS=30

# --- White-label branding ---
# Name shown in the sidebar, login screen, shared pages, browser tab, and PWA.
APP_NAME=Sjodin Photos
# Short name used under the home-screen icon when installed as a PWA.
APP_SHORT_NAME=Photos
# Attribution link at the bottom of shared album pages. Set the text to an
# empty string to hide the footer entirely.
ATTRIBUTION_TEXT=Photoalbum by Mats Sjödin
ATTRIBUTION_URL=https://matssjodin.com
