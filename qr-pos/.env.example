# Postgres connection (matches docker-compose.yml)
DATABASE_URL="postgresql://qrpos:qrpos@localhost:5432/qrpos?schema=public"

# Public origin the browser hits (used for QR code URLs in admin)
APP_ORIGIN="http://localhost:3000"

# Staff ticket age-escalation thresholds (seconds): green < warn, yellow warn..danger, red > danger
TICKET_WARN_SECONDS=300
TICKET_DANGER_SECONDS=600
